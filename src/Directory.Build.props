<Project>
  <PropertyGroup>
    <Company>XperiAndri</Company>
    <Product>Elmish.Uno</Product>
    <Authors>XperiAndri, Dim-37</Authors>
    <Copyright>Copyright © XperiAndri</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <DotNetVersion>net10.0</DotNetVersion>
    <Nullable>enable</Nullable>
    <LangVersion Condition="'$(MSBuildProjectExtension)'=='.csproj'">14.0</LangVersion>
    <LangVersion Condition="'$(MSBuildProjectExtension)'=='.fsproj'">10.0</LangVersion>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnableCoreMrtTooling Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(OutputType)' != 'WinExe' AND '$(OutputType)' != 'Exe'">true</EnableCoreMrtTooling>
  </PropertyGroup>
  <PropertyGroup>
    <WinAppSdkVersion>2.5.1</WinAppSdkVersion> <!-- https://www.nuget.org/packages/Microsoft.WindowsAppSDK -->
    <WinAppSdkBuildToolsVersion>10.0.28000.2705</WinAppSdkBuildToolsVersion> <!-- https://www.nuget.org/packages/Microsoft.Windows.SDK.BuildTools -->
    <WindowsSdkPackageVersion>10.0.28000.87</WindowsSdkPackageVersion> <!-- https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref -->
  </PropertyGroup>

  <!--
    Package metadata. Only the projects that set IsPackable (Elmish.Uno and Elmish.ObservableLookup) are packed.
    The version is a placeholder: CI passes -p:Version with the number that Nerdbank.GitVersioning computes (see version.json).
  -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <IsPackable>false</IsPackable>
    <Version>0.0.0-local</Version>
    <PackageProjectUrl>https://github.com/Ecierge/Elmish.Uno</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/Ecierge/Elmish.Uno/releases</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>elmish-uno-logo-128x128.png</PackageIcon>
    <RepositoryUrl>https://github.com/Ecierge/Elmish.Uno</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Release builds embed the symbols in the assemblies: GitHub Packages does not take .snupkg files, and one package then serves every feed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Deterministic paths in the assemblies that GitHub Actions builds. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
