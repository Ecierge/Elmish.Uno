<Window
  x:Class="Elmish.Uno.Samples.NewWindow.Window1"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:samples="using:Elmish.Uno.Samples"
  mc:Ignorable="d">

  <Page d:DataContext="{d:DesignInstance Type=samples:DesignData, IsDesignTimeCreatable=True}">
    <Grid d:DataContext="{Binding NewWindow1}"
    VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="Enter text:" />
      <TextBox
        Grid.Row="1"
        Height="80"
        Margin="0,5,0,5"
        AcceptsReturn="True"
        Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap" />
    </Grid>
  </Page>
</Window>
