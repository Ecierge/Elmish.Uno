<ContentDialog
  x:Class="Elmish.Uno.Samples.NewDialogStatic.DialogStatic1"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:samples="using:Elmish.Uno.Samples"
  mc:Ignorable="d"
  Title="TITLE"
  Style="{ThemeResource DefaultContentDialogStyle}"
  CloseButtonText="Close"
  CloseButtonStyle="{StaticResource AccentButtonStyle}">

  <Page>
    <Grid d:DataContext="{Binding NewDialogStatic1}"
    VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="Enter text:" />
      <TextBox
        Grid.Row="1"
        Height="80"
        Margin="0,5,0,5"
        AcceptsReturn="True"
        Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap" />
    </Grid>
  </Page>
</ContentDialog>
