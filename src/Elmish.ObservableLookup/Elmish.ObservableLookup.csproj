<Project Sdk="Microsoft.NET.Sdk">

  <Choose>
    <When Condition=" '$(OS)' == 'Windows_NT' ">
      <PropertyGroup>
        <TargetFrameworks>$(DotNetVersion);$(DotNetVersion)-windows10.0.28000</TargetFrameworks>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <TargetFramework>$(DotNetVersion)</TargetFramework>
      </PropertyGroup>
    </Otherwise>
  </Choose>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Observable lookup (grouping) collections for Elmish.Uno and WinUI data binding.</Description>
    <PackageTags>Elmish Uno WinUI ObservableCollection Lookup</PackageTags>
  </PropertyGroup>

  <Target Name="UnoDumpTargetFrameworks" />
</Project>
